{
  "name": "apparent",
  "type": "module",
  "scripts": {
    "dev": "npm run build && python3 -m http.server 8000 --directory public",
    "start": "npm run dev",
    "build": "elm make app/Main.elm --output=public/elm.js --optimize",
    "test": "elm-test",
    "format": "elm-format app src tests --yes",
    "format:check": "elm-format app src tests --validate"
  },
  "devDependencies": {
    "elm": "^0.19.1-6",
    "elm-format": "^0.8.8",
    "elm-test": "^0.19.1-revision17"
  }
}
